{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/startup.sh\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/startup.sh\" resume",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/prompt.sh\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "disableAutoMode": "disable",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [],
    "ask": [
      "mcp__nurture"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "WebFetch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(printenv:*)",
      "Bash(env:*)",
      "Bash(set)",
      "Bash(echo $NURTURE*)",
      "Bash(echo ${NURTURE*)",
      "Bash(echo \"$NURTURE*)",
      "Bash(echo \"${NURTURE*)",
      "Bash(printf*NURTURE*)",
      "Bash(export -p*)",
      "Bash(declare -p*)",
      "Bash(export)",
      "Bash(reg query:*)",
      "Bash(reg:*)",
      "Bash(powershell:*)",
      "Bash(powershell.exe:*)",
      "Bash(pwsh:*)",
      "Bash(cmd:*)",
      "Bash(cmd.exe:*)",
      "Bash(cat ~/.zshrc*)",
      "Bash(cat ~/.zprofile*)",
      "Bash(cat ~/.bash_profile*)",
      "Bash(cat ~/.bashrc*)",
      "Read(~/.zshrc)",
      "Read(~/.zprofile)",
      "Read(~/.bash_profile)",
      "Read(~/.bashrc)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*credentials*)",
      "Bash(git publish:*)"
    ]
  }
}
