      "mcp__nurture__update_strategy_board_draft",
      "mcp__nurture__*content*",
      "mcp__nurture__*shoot*",
      "mcp__nurture__*broadcast*",
      "mcp__nurture__*strategy*",
      "mcp__nurture__*prospect*",
      "mcp__nurture__*campaign*",
      "mcp__nurture__*vault*",
      "mcp__nurture__*runner*",
      "mcp__nurture__*delete*",
      "mcp__nurture__*revoke*",
      "mcp__nurture__*retire*",
      "mcp__nurture__*dismiss*",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "WebFetch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(printenv:*)",
      "Bash(env:*)",
      "Bash(set)",
      "Bash(echo $NURTURE*)",
      "Bash(echo ${NURTURE*)",
      "Bash(echo \"$NURTURE*)",
      "Bash(echo \"${NURTURE*)",
      "Bash(printf*NURTURE*)",
      "Bash(export -p*)",
      "Bash(declare -p*)",
      "Bash(export)",
      "Bash(reg query:*)",
      "Bash(reg:*)",
      "Bash(powershell:*)",
      "Bash(powershell.exe:*)",
      "Bash(pwsh:*)",
      "Bash(cmd:*)",
      "Bash(cmd.exe:*)",
      "Bash(cat ~/.zshrc*)",
      "Bash(cat ~/.zprofile*)",
      "Bash(cat ~/.bash_profile*)",
      "Bash(cat ~/.bashrc*)",
      "Read(~/.zshrc)",
      "Read(~/.zprofile)",
      "Read(~/.bash_profile)",
      "Read(~/.bashrc)"
    ]
  }
}
