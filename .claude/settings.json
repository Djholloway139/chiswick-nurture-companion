{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/update.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "disableAutoMode": "disable",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "mcp__nurture__list_tasks",
      "mcp__nurture__get_task",
      "mcp__nurture__list_document_types",
      "mcp__nurture__get_governance_vocabulary",
      "mcp__nurture__get_document",
      "mcp__nurture__list_audit_cycles",
      "mcp__nurture__get_audit_cycle",
      "mcp__nurture__get_workspace_report",
      "Bash(bash scripts/doctor.sh)",
      "Bash(bash scripts/update.sh)"
    ],
    "ask": [
      "mcp__nurture__search_documents",
      "mcp__nurture__create_task",
      "mcp__nurture__update_task",
      "mcp__nurture__comment_on_task",
      "mcp__nurture__attach_document_to_task",
      "mcp__nurture__upload_document",
      "mcp__nurture__update_document_metadata",
      "mcp__nurture__attach_audit_evidence"
    ],
    "deny": [
      "mcp__nurture__revoke_assessment_report_links",
      "mcp__nurture__list_vault_secret_keys",
      "mcp__nurture__create_vault_secret_key",
      "mcp__nurture__list_vault_secret_key_groups",
      "mcp__nurture__create_vault_secret_key_group",
      "mcp__nurture__update_vault_secret_key",
      "mcp__nurture__update_vault_secret_key_group",
      "mcp__nurture__retire_vault_secret_key",
      "mcp__nurture__list_vault_secret_key_finders",
      "mcp__nurture__get_content_context",
      "mcp__nurture__create_broadcast_draft",
      "mcp__nurture__register_shoot",
      "mcp__nurture__read_shoot",
      "mcp__nurture__write_shoot_brief",
      "mcp__nurture__store_shoot_brief_options",
      "mcp__nurture__pick_shoot_brief_option",
      "mcp__nurture__reserve_shoot_file",
      "mcp__nurture__fetch_tiktok_creator_info",
      "mcp__nurture__search_instagram_audio",
      "mcp__nurture__list_content_post_types",
      "mcp__nurture__list_content_pieces",
      "mcp__nurture__create_content_piece",
      "mcp__nurture__get_content_piece",
      "mcp__nurture__update_content_piece",
      "mcp__nurture__request_content_stage",
      "mcp__nurture__adapt_content_piece",
      "mcp__nurture__attach_content_media",
      "mcp__nurture__reorder_content_media",
      "mcp__nurture__dismiss_content_media",
      "mcp__nurture__read_source",
      "mcp__nurture__compose_campaign_draft",
      "mcp__nurture__get_docs_schemas",
      "mcp__nurture__get_documents_pending",
      "mcp__nurture__post_documents_by_id_chunks",
      "mcp__nurture__post_documents_by_id_complete",
      "mcp__nurture__get_runner_jobs",
      "mcp__nurture__post_runner_jobs_by_id_complete",
      "mcp__nurture__post_runner_jobs_by_id_attempt",
      "mcp__nurture__post_runner_jobs_by_id_evidence",
      "mcp__nurture__query_prospects",
      "mcp__nurture__get_prospect",
